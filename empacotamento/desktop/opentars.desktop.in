[Desktop Entry]
Type=Application
Name=openTARS
GenericName=@desktop.generico@
Comment=@desktop.comentario@
Exec=/usr/bin/opentars-gui
Icon=opentars
Terminal=false
Categories=Utility;
Keywords=@desktop.palavras@
StartupNotify=true
StartupWMClass=Opentars
Actions=barra-rapida;

[Desktop Action barra-rapida]
Name=@desktop.barra_rapida@
Exec=/usr/bin/opentars-gui --rapido
