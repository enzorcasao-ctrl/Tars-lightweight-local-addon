#!/bin/bash
# Lançador do openTARS (modo terminal). Também atende por "tars".

set -euo pipefail

DIR_OPENTARS="/usr/share/opentars"
VENV_PYTHON="$DIR_OPENTARS/venv/bin/python3"

if [ "${1:-}" = "--setup" ] || [ "${1:-}" = "--configurar" ]; then
    # O setup escreve em /usr/share/opentars, então precisa de root.
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo bash "$DIR_OPENTARS/setup.sh"
    fi
    exec bash "$DIR_OPENTARS/setup.sh"
fi

# O pyautogui (via python-xlib) aborta na importação se não houver
# arquivo de autorização do X. Em sessões sem ~/.Xauthority e sem
# $XAUTHORITY definido não existe cookie nenhum mesmo, então apontar
# pra um arquivo vazio só evita o crash, sem mudar a permissão de acesso.
if [ -z "${XAUTHORITY:-}" ] && [ ! -f "$HOME/.Xauthority" ]; then
    export XAUTHORITY=/dev/null
fi

if [ -x "$VENV_PYTHON" ]; then
    exec "$VENV_PYTHON" "$DIR_OPENTARS/tars.py" "$@"
else
    exec python3 "$DIR_OPENTARS/tars.py" "$@"
fi
