#!/bin/bash
# Lançador da interface gráfica do openTARS. Também atende por "tars-gui".
#   opentars-gui            abre a janela
#   opentars-gui --rapido   abre a barra rápida (é o que o atalho global chama)

set -euo pipefail

DIR_OPENTARS="/usr/share/opentars"
PYTHON="$DIR_OPENTARS/venv/bin/python3"
[ -x "$PYTHON" ] || PYTHON=python3

# O pyautogui (via python-xlib) aborta na importação se não houver
# arquivo de autorização do X. Em sessões sem ~/.Xauthority e sem
# $XAUTHORITY definido não existe cookie nenhum mesmo, então apontar
# pra um arquivo vazio só evita o crash, sem mudar a permissão de acesso.
if [ -z "${XAUTHORITY:-}" ] && [ ! -f "$HOME/.Xauthority" ]; then
    export XAUTHORITY=/dev/null
fi

# Já está aberto? Só manda o recado pra ele (mostrar a janela ou a barra)
# e sai: só biblioteca padrão, responde na hora — sem carregar o openTARS
# inteiro de novo.
comando=mostrar
for arg in "$@"; do
    case "$arg" in --rapido|--quick) comando=rapido ;; esac
done
if "$PYTHON" -c 'import sys; sys.path.insert(0, sys.argv[1]); import tars_instancia as i; sys.exit(0 if i.enviar(sys.argv[2], sys.argv[3] or None) else 1)' \
        "$DIR_OPENTARS" "$comando" "${DESKTOP_STARTUP_ID:-}" 2>/dev/null; then
    exit 0
fi

exec "$PYTHON" "$DIR_OPENTARS/tars_gui.py" "$@"
