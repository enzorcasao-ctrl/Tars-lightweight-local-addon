#!/bin/bash
# Executado pelo dpkg/apt depois de copiar os arquivos do pacote.
# A lógica de "o que instalar e o que pular" mora em setup.sh, que
# também pode ser rodado de novo a qualquer momento com
# "opentars --setup" (ex: se a internet caiu durante a instalação).

set -e

case "$1" in
    configure)
        # Migração do pacote antigo "tars" (<= 1.0.0): o dpkg já removeu
        # os arquivos dele, mas o ambiente Python que o setup antigo criou
        # em /usr/share/tars/venv não pertence a nenhum pacote e ficaria
        # órfão ocupando espaço. Os dados do usuário (~/.tars_sessoes.json,
        # ~/.tars_log/) ficam no home e continuam intactos.
        if [ -d /usr/share/tars/venv ] && ! dpkg-query -W -f='${Status}' tars 2>/dev/null | grep -q "ok installed"; then
            rm -rf /usr/share/tars/venv
            rmdir /usr/share/tars 2>/dev/null || true
        fi

        bash /usr/share/opentars/setup.sh || true

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        ;;
esac

exit 0
